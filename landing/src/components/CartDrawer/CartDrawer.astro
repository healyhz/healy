---
import type { Products } from '../../types/products';
import styles from './styles.module.css';
import CloseIcon from '../../assets/icons/close.svg';
import CartIcon from '../../assets/icons/cart.svg';

interface Props {
  products: Products;
}

const { products } = Astro.props;

const productsMap = Object.fromEntries(
  products.map((p) => [p.slug, { name: p.name, price: p.price, img: '/assets/healy-wellness.png' }])
);
---

<div class={styles.overlay} id="cartOverlay"></div>
<aside class={styles.drawer} id="cartDrawer" aria-hidden="true">
  <div class={styles.head}>
    <h3>Корзина <span class={styles.cnt} id="cartCnt">0 товаров</span></h3>
    <button class={styles.close} id="cartClose" aria-label="Закрыть">
      <CloseIcon />
    </button>
  </div>
  <div class={styles.body} id="cartBody">
    <div class={styles.empty} id="cartEmpty">
      <div class={styles.emptyIcon}>
        <CartIcon width="32" height="32" stroke-width="1.5" />
      </div>
      <p>В корзине пока пусто.<br />Добавьте товар из каталога.</p>
      <a href="#catalog" class="btn btn-outline" data-close-cart>Перейти в каталог</a>
    </div>
  </div>
  <div class={styles.foot} id="cartFoot" style="display:none">
    <div class={styles.footRow}><span>Подытог</span><span id="cartSubtotal">0 ₽</span></div>
    <div class={styles.footRow}>
      <span>Доставка СДЭК</span><span>рассчитывается на оформлении</span>
    </div>
    <div class:list={[styles.footRow, styles.footTotal]}>
      <span>К оплате</span><span class={styles.totalVal} id="cartTotal">0 ₽</span>
    </div>
    <a href="#" class="btn">Оформить заказ</a>
    <a href="#" class={styles.contShopping} data-close-cart>Продолжить покупки</a>
  </div>
</aside>

<script define:vars={{ productsMap }} is:inline>
  const PRODUCTS = productsMap;

  let cart = JSON.parse(localStorage.getItem('healy_cart') || '{}');

  function saveCart() {
    localStorage.setItem('healy_cart', JSON.stringify(cart));
  }

  function fmt(n) {
    return n.toLocaleString('ru-RU') + ' ₽';
  }

  function plural(n) {
    const m10 = n % 10,
      m100 = n % 100;
    if (m10 === 1 && m100 !== 11) return n + ' товар';
    if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return n + ' товара';
    return n + ' товаров';
  }

  function renderCart() {
    const body = document.getElementById('cartBody');
    const foot = document.getElementById('cartFoot');
    const empty = document.getElementById('cartEmpty');
    const cnt = document.getElementById('cartCnt');
    const ids = Object.keys(cart);
    const totalQty = ids.reduce((s, k) => s + cart[k], 0);

    const badge = document.getElementById('cartCount');
    if (badge) badge.textContent = String(totalQty);
    cnt.textContent = plural(totalQty);

    body.querySelectorAll('[data-cart-item]').forEach((n) => n.remove());

    if (ids.length === 0) {
      empty.style.display = 'block';
      foot.style.display = 'none';
      return;
    }

    empty.style.display = 'none';
    foot.style.display = 'block';

    let subtotal = 0;
    ids.forEach((id) => {
      const p = PRODUCTS[id];
      if (!p) return;
      const q = cart[id];
      subtotal += p.price * q;

      const div = document.createElement('div');
      div.dataset.cartItem = id;
      div.className = 'cart-item-el';
      div.style.cssText =
        'display:flex;gap:16px;padding:20px 28px;border-bottom:1px solid var(--line);';
      div.innerHTML = `
        <div style="width:84px;height:84px;flex-shrink:0;background:var(--bg-warm);border-radius:6px;display:grid;place-items:center;overflow:hidden;">
          <img src="${p.img}" alt="" style="width:80%;height:80%;object-fit:contain;" />
        </div>
        <div style="flex:1;min-width:0;">
          <p style="font-weight:500;font-size:14px;margin:0 0 12px;color:var(--ink-2);">${p.name}</p>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
            <div style="display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:999px;overflow:hidden;">
              <button data-qty="-1" data-item="${id}" style="width:30px;height:30px;border:none;background:#fff;color:var(--ink-2);cursor:pointer;font-size:16px;">−</button>
              <span style="width:32px;text-align:center;font-size:13px;font-weight:500;">${q}</span>
              <button data-qty="1" data-item="${id}" style="width:30px;height:30px;border:none;background:#fff;color:var(--ink-2);cursor:pointer;font-size:16px;">+</button>
            </div>
            <span style="font-weight:600;color:var(--cobalt);font-size:15px;">${fmt(p.price * q)}</span>
          </div>
          <button data-remove="${id}" style="background:none;border:none;color:var(--ink-4);cursor:pointer;font-size:12px;padding:4px;margin-top:4px;">Удалить</button>
        </div>`;
      body.appendChild(div);
    });

    const subtotalEl = document.getElementById('cartSubtotal');
    const totalEl = document.getElementById('cartTotal');
    if (subtotalEl) subtotalEl.textContent = fmt(subtotal);
    if (totalEl) totalEl.textContent = fmt(subtotal);
  }

  function addToCart(id) {
    cart[id] = (cart[id] || 0) + 1;
    saveCart();
    renderCart();
    openCart();
    const badge = document.getElementById('cartCount');
    if (badge) {
      badge.style.transform = 'scale(1.4)';
      setTimeout(() => {
        badge.style.transform = '';
      }, 200);
    }
  }

  function openCart() {
    document.getElementById('cartOverlay')?.classList.add('open');
    const drawer = document.getElementById('cartDrawer');
    if (drawer) {
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
    }
    document.body.style.overflow = 'hidden';
  }

  function closeCart() {
    document.getElementById('cartOverlay')?.classList.remove('open');
    const drawer = document.getElementById('cartDrawer');
    if (drawer) {
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
    }
    document.body.style.overflow = '';
  }

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-cart-id]');
    if (btn) {
      e.preventDefault();
      addToCart(btn.dataset.cartId);
      return;
    }

    const qtyBtn = e.target.closest('[data-qty]');
    if (qtyBtn) {
      const id = qtyBtn.dataset.item;
      const delta = parseInt(qtyBtn.dataset.qty);
      cart[id] = (cart[id] || 0) + delta;
      if ((cart[id] ?? 0) <= 0) delete cart[id];
      saveCart();
      renderCart();
      return;
    }

    const removeBtn = e.target.closest('[data-remove]');
    if (removeBtn) {
      delete cart[removeBtn.dataset.remove];
      saveCart();
      renderCart();
      return;
    }

    if (e.target.closest('[data-close-cart]')) {
      e.preventDefault();
      closeCart();
    }
  });

  document.getElementById('cartTrigger')?.addEventListener('click', openCart);
  document.getElementById('cartClose')?.addEventListener('click', closeCart);
  document.getElementById('cartOverlay')?.addEventListener('click', closeCart);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeCart();
  });

  renderCart();
</script>

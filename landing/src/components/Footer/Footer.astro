              <path d="M21.7 4.3 2.5 11.5c-.9.4-1 1-.3 1.3l4.6 1.4 1.7 5.6c.2.6.6.8 1.2.4l2.7-2 4.7 3.5c.7.4 1.2.2 1.4-.7l3-13.7c.3-1.2-.4-1.7-1.6-1.2Zm-2.3 4-7.5 6.7-.3 3-1.5-4.7 9.3-5Z"></path>
            </svg>
          </a>
          <a class={styles.social} href="#" aria-label="VK">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">

            </svg>
          </a>
          <a class={styles.social} href="#" aria-label="WhatsApp">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.2-1.3A10 10 0 1 0 12 2Zm5 13.7c-.2.6-1.2 1.2-1.7 1.2-.5 0-.5.4-3-.6s-3.7-3-3.8-3.2a4.7 4.7 0 0 1-1-2.5c0-1 .5-1.5.7-1.7.2-.2.4-.3.6-.3h.4c.1 0 .3 0 .4.4l.7 1.7c.1.1 0 .3 0 .4l-.4.5c-.1.2-.3.3-.1.6.2.3.7 1.1 1.5 1.8 1 .8 1.7 1.1 2 1.2.2.1.4.1.5 0 .2-.2.6-.7.8-.9.1-.2.3-.2.5-.1l1.6.7c.2.1.4.2.4.3 0 .2 0 .9-.2 1.5Z"></path>
            </svg>
          </a>
          <a class={styles.social} href="#" aria-label="YouTube">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23 12s0-3.6-.5-5.3a2.7 2.7 0 0 0-1.9-1.9C18.9 4.3 12 4.3 12 4.3s-6.9 0-8.6.5a2.7 2.7 0 0 0-1.9 1.9C1 8.4 1 12 1 12s0 3.6.5 5.3c.3 1 1 1.6 1.9 1.9 1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5a2.7 2.7 0 0 0 1.9-1.9c.5-1.7.5-5.3.5-5.3ZM10 15.5v-7l6 3.5-6 3.5Z"></path>
            </svg>
          </a>
        </div>
      </div>
      <div class={styles.col}>
        <h4>Покупателям</h4>
        <ul>
          <li><a href="#">Доставка и оплата</a></li>
          <li><a href="#">Возврат</a></li>
          <li><a href="#">Гарантия</a></li>
          <li><a href="#">FAQ</a></li>
        </ul>
      </div>
      <div class={styles.col}>
        <h4>Документы</h4>

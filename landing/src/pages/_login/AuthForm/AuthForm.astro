---
import styles from "./styles.module.css";
---

<header class={styles.header}>
  <a href="/" class={styles.logo} aria-label="Healy">
    <img src="/assets/healy-logo.svg" alt="Healy" />
  </a>
  <a href="/" class={styles.back}>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="m15 18-6-6 6-6"></path>
    </svg>
    <span>На главную</span>
  </a>
</header>

<main class={styles.shell}>
  <div class={styles.formCol}>
    <div class={styles.panel}>

      <div class={styles.tabs} id="authTabs">
        <button type="button" class:list={[styles.tab, "active"]} data-auth-tab="login">Вход</button>
        <button type="button" class={styles.tab} data-auth-tab="register">Регистрация</button>
      </div>

      <!-- LOGIN -->
      <section data-screen-panel id="screen-login">
        <h2 class={styles.panelTitle}>С возвращением.</h2>
        <p class={styles.sub}>Войдите, чтобы посмотреть заказы и управлять подпиской.</p>

        <form id="loginForm">
          <div class={styles.formErr} id="loginError" hidden></div>
          <div class={styles.field}>
            <label class={styles.fieldLabel} for="loginEmail">Email</label>
            <div class={styles.inputWrap}>
              <input class={styles.input} id="loginEmail" type="email" placeholder="you@example.com" required autocomplete="email" />
            </div>
          </div>
          <div class={styles.field}>
            <label class={styles.fieldLabel} for="loginPwd">Пароль</label>
            <div class={styles.inputWrap}>
              <input class:list={[styles.input, styles.inputHasIcon]} id="loginPwd" type="password" placeholder="Введите пароль" required autocomplete="current-password" />
              <button type="button" class={styles.pwdToggle} data-toggle-pwd="loginPwd" aria-label="Показать пароль">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>
          <div class={styles.rowBetween}>
            <label class={styles.check}>
              <input type="checkbox" /> Запомнить меня
            </label>
            <button type="button" class={styles.link} data-show-screen="forgot">Забыли пароль?</button>
          </div>
          <button type="submit" class:list={["btn", styles.submitBtn]} id="loginBtn">Войти</button>
        </form>

        <p class={styles.switchLine}>Ещё нет аккаунта? <button type="button" class={styles.link} data-show-screen="register">Создать</button></p>
      </section>

      <!-- REGISTER -->
      <section data-screen-panel id="screen-register" hidden>
        <h2 class={styles.panelTitle}>Создать аккаунт.</h2>
        <p class={styles.sub}>Понадобится для оформления заказа и доступа к личному кабинету.</p>

        <form id="registerForm">
          <div class={styles.formErr} id="registerError" hidden></div>
          <div class={styles.row2}>
            <div class={styles.field}>
              <label class={styles.fieldLabel} for="regName">Имя</label>
              <div class={styles.inputWrap}>
                <input class={styles.input} id="regName" type="text" placeholder="Иван" required autocomplete="given-name" />
              </div>
            </div>
            <div class={styles.field}>
              <label class={styles.fieldLabel} for="regSurname">Фамилия</label>
              <div class={styles.inputWrap}>
                <input class={styles.input} id="regSurname" type="text" placeholder="Иванов" required autocomplete="family-name" />
              </div>
            </div>
          </div>
          <div class={styles.field}>
            <label class={styles.fieldLabel} for="regEmail">Email</label>
            <div class={styles.inputWrap}>
              <input class={styles.input} id="regEmail" type="email" placeholder="you@example.com" required autocomplete="email" />
            </div>
          </div>
          <div class={styles.field}>
            <label class={styles.fieldLabel} for="regPhone">Телефон</label>
            <div class={styles.inputWrap}>
              <input class={styles.input} id="regPhone" type="tel" placeholder="+7 (___) ___-__-__" autocomplete="tel" />
            </div>
          </div>
          <div class={styles.field}>
            <label class={styles.fieldLabel} for="regPwd">Пароль</label>
            <div class={styles.inputWrap}>
              <input class:list={[styles.input, styles.inputHasIcon]} id="regPwd" type="password" placeholder="Минимум 8 символов" required minlength="8" autocomplete="new-password" />
              <button type="button" class={styles.pwdToggle} data-toggle-pwd="regPwd" aria-label="Показать пароль">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
            <p class={styles.hint}>Минимум 8 символов, должна быть хотя бы одна цифра.</p>
          </div>
          <button type="submit" class:list={["btn", styles.submitBtn]} id="registerBtn">Создать аккаунт</button>
        </form>

        <p class={styles.terms}>
          Создавая аккаунт, вы соглашаетесь с <a href="#">Условиями использования</a> и <a href="#">Политикой конфиденциальности</a>.
        </p>
      </section>

      <!-- FORGOT -->
      <section data-screen-panel id="screen-forgot" hidden>
        <span class="eyebrow">Восстановление пароля</span>
        <h2 class={styles.panelTitle}>Забыли пароль?</h2>
        <p class={styles.sub}>Введите email — мы отправим письмо со ссылкой для сброса.</p>

        <form id="forgotForm">
          <div class={styles.field}>
            <label class={styles.fieldLabel} for="forgotEmail">Email</label>
            <div class={styles.inputWrap}>
              <input class={styles.input} id="forgotEmail" type="email" placeholder="you@example.com" required autocomplete="email" />
            </div>
          </div>
          <button type="submit" class:list={["btn", styles.submitBtn]}>Отправить ссылку</button>
        </form>

        <p class={styles.switchLine}>Вспомнили пароль? <button type="button" class={styles.link} data-show-screen="login">Войти</button></p>
      </section>

      <!-- FORGOT SUCCESS -->
      <section data-screen-panel id="screen-forgot-success" hidden>
        <div class={styles.successState}>
          <div class={styles.checkIcon}>
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="m5 12 5 5L20 7"></path>
            </svg>
          </div>
          <h2 class={styles.panelTitle}>Проверьте почту.</h2>
          <p class={styles.sub}>Если такой email зарегистрирован, мы отправили письмо со ссылкой для сброса пароля. Ссылка действует 30 минут.</p>
          <button type="button" class:list={["btn", styles.submitBtn]} data-show-screen="login">Вернуться ко входу</button>
          <p class={styles.terms}>Не пришло письмо? Проверьте папку «Спам» или <button type="button" class={styles.link} data-show-screen="forgot">отправьте ещё раз</button>.</p>
        </div>
      </section>

      <!-- REGISTER SUCCESS -->
      <section data-screen-panel id="screen-register-success" hidden>
        <div class={styles.successState}>
          <div class={styles.checkIcon}>
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="m5 12 5 5L20 7"></path>
            </svg>
          </div>
          <h2 class={styles.panelTitle}>Аккаунт создан.</h2>
          <p class={styles.sub}>Мы отправили письмо для подтверждения email. Откройте его, чтобы активировать аккаунт.</p>
          <a href="/" class:list={["btn", styles.submitBtn]}>Перейти в каталог</a>
        </div>
      </section>

    </div>
  </div>
</main>

<script>
  const eyeOn = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>`;
  const eyeOff = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.2 4.2M9.4 5.6A10 10 0 0 1 12 5c6 0 10 7 10 7a17 17 0 0 1-3.3 4.1M6.6 6.6A17 17 0 0 0 2 12s4 7 10 7a10 10 0 0 0 4.2-.9"/></svg>`;

  function showScreen(name: string) {
    document.querySelectorAll("[data-screen-panel]").forEach((s) => {
      (s as HTMLElement).hidden = true;
    });
    const target = document.getElementById("screen-" + name);
    if (target) target.hidden = false;

    const tabsBar = document.getElementById("authTabs");
    const isAuthTab = name === "login" || name === "register";
    if (tabsBar) tabsBar.hidden = !isAuthTab;

    if (isAuthTab) {
      document.querySelectorAll("[data-auth-tab]").forEach((t) => {
        const btn = t as HTMLElement;
        btn.classList.toggle("active", btn.dataset.authTab === name);
      });
    }

    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function showFormError(id: string, msg: string) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
  }

  function clearFormError(id: string) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = "";
    el.hidden = true;
  }

  function setBtnLoading(btn: HTMLButtonElement, loading: boolean, label: string) {
    btn.disabled = loading;
    btn.textContent = loading ? "Загрузка…" : label;
  }

  document.addEventListener("click", (e) => {
    const tab = (e.target as Element).closest<HTMLElement>("[data-auth-tab]");
    if (tab) { showScreen(tab.dataset.authTab!); return; }

    const trigger = (e.target as Element).closest<HTMLElement>("[data-show-screen]");
    if (trigger) { e.preventDefault(); showScreen(trigger.dataset.showScreen!); return; }

    const pwdBtn = (e.target as Element).closest<HTMLElement>("[data-toggle-pwd]");
    if (pwdBtn) {
      const input = document.getElementById(pwdBtn.dataset.togglePwd!) as HTMLInputElement;
      const isHidden = input.type === "password";
      input.type = isHidden ? "text" : "password";
      pwdBtn.innerHTML = isHidden ? eyeOff : eyeOn;
      pwdBtn.setAttribute("aria-label", isHidden ? "Скрыть пароль" : "Показать пароль");
    }
  });

  document.getElementById("loginForm")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearFormError("loginError");
    const btn = document.getElementById("loginBtn") as HTMLButtonElement;
    setBtnLoading(btn, true, "Войти");
    try {
      const apiUrl = (window as any).ENV?.API_URL ?? "";
      const res = await fetch(`${apiUrl}/api/auth/sign-in/email`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({
          email: (document.getElementById("loginEmail") as HTMLInputElement).value,
          password: (document.getElementById("loginPwd") as HTMLInputElement).value,
        }),
      });
      if (res.ok) {
        window.location.href = (window as any).ENV?.APP_URL ?? "/";
      } else {
        const data = await res.json();
        showFormError("loginError", data.message || "Произошла ошибка. Попробуйте снова.");
        setBtnLoading(btn, false, "Войти");
      }
    } catch {
      showFormError("loginError", "Не удалось подключиться к серверу.");
      setBtnLoading(btn, false, "Войти");
    }
  });

  document.getElementById("registerForm")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearFormError("registerError");
    const btn = document.getElementById("registerBtn") as HTMLButtonElement;
    setBtnLoading(btn, true, "Создать аккаунт");
    try {
      const apiUrl = (window as any).ENV?.API_URL ?? "";
      const res = await fetch(`${apiUrl}/api/auth/sign-up/email`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({
          name: `${(document.getElementById("regName") as HTMLInputElement).value} ${(document.getElementById("regSurname") as HTMLInputElement).value}`.trim(),
          email: (document.getElementById("regEmail") as HTMLInputElement).value,
          password: (document.getElementById("regPwd") as HTMLInputElement).value,
        }),
      });
      if (res.ok) {
        window.location.href = (window as any).ENV?.APP_URL ?? "/";
      } else {
        const data = await res.json();
        showFormError("registerError", data.message || "Произошла ошибка. Попробуйте снова.");
        setBtnLoading(btn, false, "Создать аккаунт");
      }
    } catch {
      showFormError("registerError", "Не удалось подключиться к серверу.");
      setBtnLoading(btn, false, "Создать аккаунт");
    }
  });

  document.getElementById("forgotForm")?.addEventListener("submit", (e) => {
    e.preventDefault();
    showScreen("forgot-success");
  });
</script>

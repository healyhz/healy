---
import type { Products } from '../../../types/products';
import styles from './styles.module.css';

interface Props {
  products: Products;
}

const { products } = Astro.props;
---

<section class={styles.section} id="catalog">
  <div class="container">
    <div class:list={['section-head row reveal', styles.head]}>
      <div>
        <span class="eyebrow">Ключевые продукты</span>
        <h2>Healy Wellness — линейка.</h2>
      </div>
      <a href="#" class="btn btn-outline">Весь каталог →</a>
    </div>
    <div class:list={[styles.grid, 'reveal']}>
      {
        products.map((product) => (
          <a href="#" class={styles.card}>
            <div class={styles.cardMedia}>
              <img class={styles.photo} src="/assets/healy-wellness.png" alt={product.name} />
            </div>
            <div class={styles.cardBody}>
              <h3>{product.name}</h3>
              <p class={styles.desc}>{product.description}</p>
              <div class={styles.foot}>
                <div class={styles.price}>
                  {product.price.toLocaleString('ru-RU')}
                  <span class={styles.currency}>₽</span>
                </div>
                <div class={styles.actions}>
                  <button class:list={['btn', styles.btnCart]} data-cart-id={product.slug}>
                    В корзину
                  </button>
                  <span class={styles.btnIcon} aria-label="Подробнее">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M5 12h14m-6-6 6 6-6 6" />
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

---
import styles from "./styles.module.css";
import ArrowRight from '../../../assets/icons/arrow-right.svg';
import CheckIcon from '../../../assets/icons/check.svg';
---

<section class={styles.hero}>
  <div class:list={["container", styles.grid]}>
    <div class="reveal">
      <span class="eyebrow">Healy в России</span>
      <h1>Носимое устройство для гармонии и баланса.</h1>
      <p class:list={["lede", styles.sub]}>
        Healy Wellness — частотные программы для релаксации, фитнеса и энергии.
        Для тех, кто заботится о своём состоянии и встраивает практики в обычный день.
      </p>
      <div class={styles.cta}>
        <a href="#catalog" class="btn btn-lg">
          Перейти в каталог
          <ArrowRight class="arrow" />
        </a>
        <a href="#how" class="btn btn-outline btn-lg">Как это работает</a>
      </div>
      <div class={styles.trust}>
        <span class={styles.trustItem}>
          <span class={styles.trustIcon}>
            <CheckIcon width="12" height="12" stroke-width="3" />
          </span>
          Официальный дистрибьютор
        </span>
        <span class={styles.trustItem}>
          <span class={styles.trustIcon}>
            <CheckIcon width="12" height="12" stroke-width="3" />
          </span>
          Доставка СДЭК по России
        </span>
        <span class={styles.trustItem}>
          <span class={styles.trustIcon}>
            <CheckIcon width="12" height="12" stroke-width="3" />
          </span>
          Гарантия 2 года
        </span>
        <span class={styles.trustItem}>
          <span class={styles.trustIcon}>
            <CheckIcon width="12" height="12" stroke-width="3" />
          </span>
          Поддержка на русском
        </span>
      </div>
    </div>
    <div class:list={[styles.media, "reveal"]} role="img" aria-label="Healy Wellness">
      <img src="/assets/healy-wellness.png" alt="Healy Wellness" />
    </div>
  </div>
</section>

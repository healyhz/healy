---
import styles from "./styles.module.css";
import PulseIcon from '../../../assets/icons/pulse.svg';
import PhoneIcon from '../../../assets/icons/phone.svg';
import ClockIcon from '../../../assets/icons/clock.svg';
import ShieldIcon from '../../../assets/icons/shield.svg';
---

<section class={styles.section} id="about">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Почему Healy</span>
      <h2>Что отличает наше предложение.</h2>
    </div>
    <div class:list={[styles.grid, "reveal"]}>
      <div class={styles.card}>
        <div class={styles.icon}>
          <PulseIcon />
        </div>
        <h3>Частотные программы</h3>
        <p>Программы для релаксации, фитнеса и энергии — настраиваются через приложение Healy.</p>
      </div>
      <div class={styles.card}>
        <div class={styles.icon}>
          <PhoneIcon />
        </div>
        <h3>iOS и Android</h3>
        <p>Управление через Healy App. Подключение по Bluetooth, история сессий, выбор программ.</p>
      </div>
      <div class={styles.card}>
        <div class={styles.icon}>
          <ClockIcon />
        </div>
        <h3>Сессия фоном</h3>
        <p>20–60 минут в обычном режиме дня. Healy крепится на одежду и не требует отдельного времени.</p>
      </div>
      <div class={styles.card}>
        <div class={styles.icon}>
          <ShieldIcon />
        </div>
        <h3>Гарантия 2 года</h3>
        <p>Официальная гарантия от производителя. Поддержка на русском, доставка СДЭК по России.</p>
      </div>
    </div>
  </div>
</section>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import CartDrawer from '../components/CartDrawer/CartDrawer.astro';
import Hero from './_index/Hero/Hero.astro';
import Catalog from './_index/Catalog/Catalog.astro';
import HowToUse from './_index/HowToUse/HowToUse.astro';
import Features from './_index/Features/Features.astro';
import UseCases from './_index/UseCases/UseCases.astro';
import Partners from './_index/Partners/Partners.astro';
import SocialProof from './_index/SocialProof/SocialProof.astro';
import Faq from './_index/Faq/Faq.astro';
import FinalCta from './_index/FinalCta/FinalCta.astro';
import type { Products } from '../types/products';

let products: Products = [];

try {
  const res = await fetch(`${process.env.API_URL}/api/products`);
  if (res.ok) products = await res.json();
} catch (e) {}
---

<Layout
  title="Healy — официальный дистрибьютор в России"
  description="Healy Wellness — носимое устройство с частотными программами для релаксации, фитнеса и энергии. Официальный дистрибьютор в России, доставка СДЭК, гарантия 2 года."
>
  <Header />
  <main>
    <Hero />
    <Catalog products={products} />
    <HowToUse />
    <Features />
    <UseCases />
    <Partners />
    <SocialProof />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <CartDrawer products={products} />
</Layout>
